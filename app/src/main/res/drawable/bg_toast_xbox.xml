<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft outer glow using the green accent, very subtle -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A5CC500" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Main panel, inset slightly so the glow shows as a ring -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F2181818"
                android:endColor="#F20E0E0E" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="@color/xbox_border" />
        </shape>
    </item>

</layer-list>
