<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gamepad D-pad focus -->
    <item android:state_focused="true" android:drawable="@drawable/bg_button_xbox_focused" />
    <!-- Touch / A-button press -->
