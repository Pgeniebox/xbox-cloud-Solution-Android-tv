<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_xbox"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:background="@color/xbox_green_bright"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAMING MENU"
            android:textColor="@color/selector_text_xbox"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_exit_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exit the game"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gamepad Settings"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_app_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App Settings"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_reload_xbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reload Xbox"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_performance_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show in game performance"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_open_nexus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Nexus"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="6dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_mic_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Microphone: Disabled"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/xbox_border"
        android:layout_marginBottom="10dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close Menu"
        android:textColor="@color/selector_text_xbox"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/selector_button_xbox"
        android:focusable="true"/>

</LinearLayout>